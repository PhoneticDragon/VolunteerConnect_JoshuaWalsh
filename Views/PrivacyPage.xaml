<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VolunteerConnect.Views.PrivacyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Privacy Information">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Page Title -->

            <Label
                Text="Privacy Information"
                FontSize="30"
                FontAttributes="Bold" />

            <Label
                Text="VolunteerConnect is designed to collect only the information needed to manage your volunteer registration."
                FontSize="16" />

            <!-- What We Collect -->

            <Label
                Text="What Information Is Collected?"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="When you register your interest in a volunteer opportunity, the app may collect your preferred name, email address, phone number, availability and an optional note. You must also provide privacy consent before your registration can be saved."
                FontSize="16" />

            <!-- Data Minimisation -->

            <Label
                Text="Data Minimisation"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="VolunteerConnect only collects information that is relevant to managing a volunteer registration. The prototype does not require your home address, date of birth, gender, ethnicity, identification documents, medical information or other unrelated personal details."
                FontSize="16" />

            <!-- Why We Collect It -->

            <Label
                Text="Why Is It Collected?"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="Your registration information is collected so the community organisation can manage your expression of interest and respond to your volunteer registration. Your contact information is not required for unrelated purposes."
                FontSize="16" />

            <!-- Consent -->

            <Label
                Text="Privacy Consent"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="You must confirm that you consent to your information being collected and used for your volunteer registration before the registration can be saved."
                FontSize="16" />

            <!-- Storage -->

            <Label
                Text="Where Is My Information Stored?"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="This prototype stores registration information in a local SQLite database on the device. It does not use cloud storage, a remote server or online synchronisation."
                FontSize="16" />

            <!-- User Control -->

            <Label
                Text="Your Control Over Your Information"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="You can view your saved registration information, correct appropriate information by editing your registration, and delete your registration and associated personal information from the device."
                FontSize="16" />

            <!-- Deletion -->

            <Label
                Text="Deleting Your Information"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="When you delete a registration, the registration record is removed from the local SQLite database. The app asks you to confirm the deletion before the record is removed."
                FontSize="16" />

            <!-- Safe Testing -->

            <Label
                Text="Safe Testing"
                FontSize="22"
                FontAttributes="Bold" />

            <Label
                Text="This prototype should be tested using fictional information only. Do not enter real personal information into the application during development or testing."
                FontSize="16" />

            <!-- Final Notice -->

            <Border
                Padding="15"
                StrokeShape="RoundRectangle 10">

                <Label
                    Text="VolunteerConnect is a prototype and is not intended to be a production-ready multi-user system."
                    FontSize="16"
                    FontAttributes="Bold" />

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>