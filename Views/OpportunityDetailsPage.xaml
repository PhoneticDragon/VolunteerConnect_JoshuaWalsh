<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VolunteerConnect.Views.OpportunityDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Opportunity Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <!-- Image -->
            <Image
                Source="{Binding Image}"
                HeightRequest="220"
                Aspect="AspectFill" />

            <!-- Title -->
            <Label
                x:Name="TitleLabel"
                Text="Loading..."
                FontSize="30"
                FontAttributes="Bold" />

            <!-- Category -->
            <Label
                x:Name="CategoryLabel"
                FontSize="18" />

            <!-- Date -->
            <Label
                x:Name="DateLabel"
                FontSize="16" />

            <!-- Time -->
            <Label
                x:Name="TimeLabel"
                FontSize="16" />

            <!-- Location -->
            <Label
                x:Name="LocationLabel"
                FontSize="16" />

            <!-- Available Places -->
            <Label
                x:Name="PlacesLabel"
                FontSize="18"
                FontAttributes="Bold" />

            <!-- Description -->
            <Label
                Text="About This Opportunity"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="DescriptionLabel"
                FontSize="16"
                LineBreakMode="WordWrap" />

            <!-- Requirements -->
            <Label
                Text="Volunteer Requirements"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <Label
                x:Name="RequirementsLabel"
                FontSize="16"
                LineBreakMode="WordWrap" />

            <!-- Register -->
            <Button
                x:Name="RegisterButton"
                Text="Register Interest"
                FontSize="18"
                Clicked="RegisterButton_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>