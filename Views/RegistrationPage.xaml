<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VolunteerConnect.Views.RegistrationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Register Interest">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="15">

            <Label
                Text="Register Your Interest"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="Opportunity"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                x:Name="OpportunityNameLabel"
                Text="Loading..."
                FontSize="18" />

            <Label
                Text="Your Information"
                FontSize="22"
                FontAttributes="Bold"
                Margin="0,10,0,0" />

            <!-- Preferred Name -->

            <Label
                Text="Preferred Name *"
                FontAttributes="Bold" />

            <Entry
                x:Name="PreferredNameEntry"
                Placeholder="Enter your preferred name"
                MaxLength="50" />

            <!-- Email -->

            <Label
                Text="Email Address *"
                FontAttributes="Bold" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="example@email.com"
                Keyboard="Email"
                MaxLength="100" />

            <!-- Phone -->

            <Label
                Text="Phone Number"
                FontAttributes="Bold" />

            <Entry
                x:Name="PhoneEntry"
                Placeholder="Enter your phone number"
                Keyboard="Telephone"
                MaxLength="20" />

            <!-- Availability -->

            <Label
                Text="Availability *"
                FontAttributes="Bold" />

            <Picker
                x:Name="AvailabilityPicker"
                Title="Select your availability">

                <Picker.Items>
                    <x:String>Weekdays</x:String>
                    <x:String>Weekends</x:String>
                    <x:String>Evenings</x:String>
                    <x:String>Flexible</x:String>
                </Picker.Items>

            </Picker>

            <!-- Optional Note -->

            <Label
                Text="Optional Note"
                FontAttributes="Bold" />

            <Editor
                x:Name="NoteEditor"
                Placeholder="Anything else you'd like us to know?"
                MaxLength="500"
                AutoSize="TextChanges"
                HeightRequest="120" />

            <!-- Privacy -->

            <Border
                Padding="15"
                StrokeShape="RoundRectangle 10">

                <VerticalStackLayout
                    Spacing="10">

                    <Label
                        Text="Privacy Consent"
                        FontSize="18"
                        FontAttributes="Bold" />

                    <Label
                        Text="Your contact details are collected only so the community organisation can respond to your volunteer registration. Your information is stored locally on this device." />

                    <Label
                        Text="Do you Consent to having your information collected and used for this registration?"/>

                    <HorizontalStackLayout
                        Spacing="10">

                        <CheckBox
                            x:Name="PrivacyConsentCheckBox" />

                        <Label
                            Text="I consent."
                            VerticalOptions="Center"
                            HorizontalOptions="Fill" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Save -->

            <Button
                x:Name="SaveButton"
                Text="Submit Registration"
                FontSize="18"
                Clicked="SaveButton_Clicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>