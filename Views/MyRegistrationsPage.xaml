<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VolunteerConnect.Views.MyRegistrationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="My Registrations">

    <ScrollView>
    <VerticalStackLayout
        Padding="15"
        Spacing="10">

        <Label
            Text="My Registrations"
            FontSize="28"
            FontAttributes="Bold" />

        <Label
            x:Name="RegistrationCountLabel"
            Text="Loading registrations..."
            FontSize="16" />

        <CollectionView
            x:Name="RegistrationsCollection"
            SelectionMode="None">

            <CollectionView.EmptyView>

                <VerticalStackLayout
                    Padding="30"
                    Spacing="15">

                    <Label
                        Text="No registrations yet."
                        FontSize="20"
                        HorizontalOptions="Center" />

                    <Label
                        Text="Your volunteer registrations will appear here after you register for an opportunity."
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Margin="5"
                        Padding="15"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="{Binding OpportunityTitle}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding PreferredName, StringFormat='Name: {0}'}"
                                FontSize="15" />

                            <Label
                                Text="{Binding Availability, StringFormat='Availability: {0}'}"
                                FontSize="15" />

                            <Label
                                Text="{Binding Email, StringFormat='Email: {0}'}"
                                FontSize="15" />

                            <HorizontalStackLayout
                                Spacing="10">

                                <Button
                                    Text="View"
                                    Clicked="ViewRegistration_Clicked"
                                    CommandParameter="{Binding .}"/>

                                <Button
                                    Text="Edit"
                                    Clicked="EditRegistration_Clicked"
                                    CommandParameter="{Binding .}"/>

                                <Button
                                    Text="Delete"
                                    Clicked="DeleteRegistration_Clicked"
                                    CommandParameter="{Binding .}"/>

                            </HorizontalStackLayout>

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

    </ScrollView>

</ContentPage>