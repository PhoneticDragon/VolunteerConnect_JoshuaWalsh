<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="VolunteerConnect.Views.OpportunitiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Opportunities">

    <ScrollView>
    <VerticalStackLayout
        Padding="15"
        Spacing="10">

        <Label
            Text="Volunteer Opportunities"
            FontSize="28"
            FontAttributes="Bold" />

        <!-- Search -->
        <SearchBar
            x:Name="SearchBar"
            Placeholder="Search opportunities..."
            TextChanged="SearchBar_TextChanged" />

        <!-- Category Filter -->
        <Picker
            x:Name="CategoryPicker"
            Title="Filter by category"
            SelectedIndexChanged="CategoryPicker_SelectedIndexChanged" />

        <!-- Opportunities -->
        <CollectionView
            x:Name="OpportunitiesCollection"
            SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border
                        Margin="5"
                        Padding="15"
                        StrokeShape="RoundRectangle 12">

                        <VerticalStackLayout
                            Spacing="8">

                            <Label
                                Text="{Binding Title}"
                                FontSize="20"
                                FontAttributes="Bold" />

                            <Label
                                Text="{Binding Category}"
                                FontSize="14" />

                            <Label
                                Text="{Binding Date, StringFormat='{}{0:dd MMMM yyyy}'}"
                                FontSize="14" />

                            <Label
                                Text="{Binding Time}"
                                FontSize="14" />

                            <Label
                                Text="{Binding Location}"
                                FontSize="14" />

                            <Label
                                Text="{Binding ShortDescription}"
                                FontSize="14" />

                            <Label
                                Text="{Binding AvailablePlaces, StringFormat='{}{0} places available'}"
                                FontSize="14" />

                            <Button
                                Text="View Details"
                                Clicked="ViewDetails_Clicked"
                                CommandParameter="{Binding .}" />

                        </VerticalStackLayout>

                    </Border>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>

    </ScrollView>
</ContentPage>